# CheersAI Vault Runtime — Linux 部署环境变量文件模板
#
# 复制为真实文件（例如 /etc/vault-runtime-api/runtime.env），填入真实值，
# 设置权限 `chmod 600` 且属主为运行 Runtime 的专用系统账户
# （见 vault-runtime-api.service）。不要把填好真实值的文件提交到版本控制。
#
# 完整字段说明见 ../../apps/vault-runtime-api/.env.example（本文件只保留
# Linux 部署实际需要设置的字段，去掉了仅供本机开发/Vite 构建使用的字段）。

# Runtime 持久化数据目录：SQLite 数据库、原始输入、脱敏产物、映射文件。
# 必须是绝对路径，必须与 Nginx Web root 物理隔离（不能是 dist/ 的子目录、
# 不能被 Nginx 静态文件服务访问到）。运行前需已存在，属主为 Runtime 服务
# 账户，权限建议 700。
VAULT_RUNTIME_DATA_DIR=/var/lib/vault-runtime-api/data

# Runtime 监听端口。Runtime 固定只绑定 127.0.0.1（loopback），不提供任何
# 监听 0.0.0.0 或指定网卡的开关；该行为在本任务范围内不可通过环境变量更改。
VAULT_RUNTIME_PORT=8787

# 允许的浏览器 CORS 来源：必须是客户实际访问原 Vault 前端时浏览器地址栏
# 使用的确切 Origin（协议+主机+端口），逗号分隔，可填多个。
# 禁止使用 "*"（会被过滤掉，导致 Runtime 因缺少有效 Origin 而启动失败退出）。
# 注意：CORS 只影响浏览器同源检查，不是接口鉴权（服务器到服务器调用不受
# CORS 限制）；真正的网络边界是 Nginx 客户 CIDR 白名单。
VAULT_RUNTIME_CORS_ORIGINS=http://<NGINX_SERVER_NAME_OR_IP>

# ---- OCR（管理员安装一次，可选，不启用则相关文件走 OCR_COMPONENT_REQUIRED 失败码）----
# 三者需同时配置才会启用 OCR；来自管理员在本机搭建的 OCR 虚拟环境，
# 参见 docs/enterprise/DEPLOYMENT.md 的 OCR 安装步骤。普通客户用户不需要
# 也不应该自行安装 OCR 组件。
# VAULT_OCR_PYTHON=/opt/vault-ocr/venv/bin/python3
# VAULT_OCR_SCRIPT=/opt/vault-ocr/pdf_ocr.py
# VAULT_OCR_MODEL_DIR=/opt/vault-ocr/models
# VAULT_OCR_TIMEOUT=300
# VAULT_OCR_MAX_PAGES=200
# VAULT_OCR_MAX_PIXELS_PER_PAGE=12000000

# ---- 旧版 .ppt 转换（LibreOffice）----
# 仅在标准安装路径之外时需要显式指定；Linux 上先确认已安装 LibreOffice
# 并且 `soffice` 可执行（见 docs/enterprise/DEPLOYMENT.md），不要依赖
# 任何 /tmp 便携副本作为生产路径。
# CHEERSAI_LIBREOFFICE_PATH=/usr/bin/soffice

# ---- FileBay 浏览器上传（可选；四项必须同时完整配置才启用）----
# 单系统用户 MVP：一台 Runtime、一个服务账户、一个固定 HTTPS 目标私有仓库；
# 所有能访问该内网页面的浏览器会话共享这一套 FileBay 配置。四个变量只由
# 部署管理员在本环境文件中维护，Runtime 仅在启动时读取一次；浏览器只能看到
# 安全状态并显式触发“测试连接 / 创建私有仓库 / 确认上传”，不能读取、修改或
# 覆盖 URL/Token/owner/repo。修改本文件后必须重启 Runtime 才生效，没有热加载。
#
# 全部四项都未设置 → 浏览器 FileBay 状态为“未配置”，Runtime 其余能力（脱敏、
# OCR、恢复、日志、沙箱/PIN、客户 API）不受影响；只设置部分或格式非法 →
# 状态为“无效”，FileBay 相关操作一律安全失败并返回固定错误码，不展示底层
# 响应正文、Token 或服务器路径。
#
# URL 必须是裸 HTTPS 根 origin（如 https://filebay.example.com），不能带用户名、
# 密码、查询串、片段或非根路径；证书校验始终开启，无法关闭。
# Token 是真实访问令牌，必须由部署管理员用安全方式获取并填写，本模板中的
# 示例值均不可用；Token 只写进本环境文件，不得提交版本库、不得出现在 URL、
# 前端、截图、日志或浏览器 storage 中。
# VAULT_FILEBAY_URL=https://<FILEBAY_SERVER_HOST>
# VAULT_FILEBAY_TOKEN=<由部署管理员安全填写>
# VAULT_FILEBAY_OWNER=<FILEBAY_OWNER>
# VAULT_FILEBAY_REPO=<FILEBAY_REPO>
