# CheersAI Vault — Enterprise Runtime environment variable reference.
#
# This file documents every environment variable involved in an enterprise
# deployment (Runtime + Web). It is NOT loaded automatically by the Rust
# binary — `vault-runtime-api` reads real process environment variables via
# `std::env::var`, there is no .env-file loader in this codebase. Export the
# variables you need (shell, systemd unit, process manager, etc.) before
# starting the binary, or `source` a copy of this file with real values
# filled in.
#
# NEVER put real values in this checked-in .env.example — copy it
# (e.g. `cp .env.example .env.local`) and fill in your own, keeping that
# copy out of version control.
#
# Full explanations: ../../docs/enterprise/DEPLOYMENT.md

# =============================================================
# Runtime (apps/vault-runtime-api) — read directly by the Rust
# binary at startup via std::env::var / std::env::var_os.
# =============================================================

# Directory for persisted batch/file state, input/output/mapping storage.
# Optional. Default: "enterprise-data" (relative to the process's working
# directory). Use an absolute path in production.
VAULT_RUNTIME_DATA_DIR=./enterprise-data

# TCP port the Runtime listens on. Always binds to 127.0.0.1 (loopback)
# only — this is a single-machine MVP, not a remote multi-user server.
# Optional. Default: 8787.
VAULT_RUNTIME_PORT=8787

# Comma-separated list of allowed CORS origins for the enterprise Web UI.
# At least one explicit origin is required — the Runtime refuses to start
# (exit code 2) if this resolves to an empty list; "*" is filtered out and
# does not count as a valid origin.
# Optional. Default: "http://127.0.0.1:5173,http://localhost:5173".
VAULT_RUNTIME_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- OCR component (scanned/image-only PDF support) ---
# Explicit path variables are optional as a group. When ALL three path
# variables below are unset, the shared component resolver looks only in the
# current user's standard CheersAI application-data directory and standard
# EasyOCR model directory. This is the supported same-user desktop/Runtime
# reuse path; it does not scan HOME, other users, PATH neighbours, or the
# network. In systemd/container deployments, explicit paths are recommended.
# If any one of the three path variables is set, explicit mode is active and
# missing/invalid fields are reported as unavailable/invalid without falling
# back to the shared installation.

# Path to the Python interpreter inside the OCR virtual environment
# (created from src-tauri/scripts/requirements-ocr.txt).
# Explicit mode only. Leave unset together with the other two path variables
# to enable same-user automatic discovery.
VAULT_OCR_PYTHON=/path/to/ocr-venv/bin/python3

# Path to src-tauri/scripts/pdf_ocr.py in this checkout.
# Explicit mode only. Leave unset together with the other two path variables
# to enable same-user automatic discovery.
VAULT_OCR_SCRIPT=/path/to/CheersAI-Vault/src-tauri/scripts/pdf_ocr.py

# Directory containing the EasyOCR model files (craft_mlt_25k.pth,
# zh_sim_g2.pth) — see docs/enterprise/DEPLOYMENT.md for how to obtain them.
# In explicit mode this must point to a directory that actually exists and
# contains both model files. In automatic discovery mode, leave it unset: the
# resolver first checks the package's model/ directory and then the current
# user's standard ~/.EasyOCR/model directory. The deep preflight remains
# offline and uses download_enabled=False, so missing models never trigger an
# automatic download.
VAULT_OCR_MODEL_DIR=/path/to/ocr-models

# Maximum time (seconds) to wait for a single OCR subprocess run before
# treating it as OCR_TIMEOUT.
# Optional. Default: 300.
VAULT_OCR_TIMEOUT=300

# Maximum number of PDF pages a single OCR run will process.
# Optional. Default: 200.
VAULT_OCR_MAX_PAGES=200

# Maximum pixels (width x height) allowed per rendered page at the fixed
# 300 DPI rendering resolution, before OCR even starts. The default
# (12,000,000) comfortably covers a full Letter/A4/Legal page at 300 DPI
# with headroom, while still rejecting clearly oversized pages (e.g. A3).
# Raise this only if you knowingly need to OCR larger physical page sizes;
# do not disable it (0 is not a valid "unlimited" value here).
# Optional. Default: 12000000.
VAULT_OCR_MAX_PIXELS_PER_PAGE=12000000

# =============================================================
# Frontend build-time variable — read by Vite at `pnpm build` /
# `pnpm dev` time, NOT by the Rust binary and NOT part of the
# Runtime process environment.
#
# Applies to BOTH the repo-root original Vault frontend (the
# customer-facing entry point for the Linux intranet deployment,
# see docs/enterprise/DEPLOYMENT.md §0 and deploy/linux/) and to
# apps/vault-pro-web (its own independent client.ts, not the
# customer entry point for this deployment).
# =============================================================

# Base URL the built frontend uses to reach the Runtime's HTTP API.
#
# Customer Linux deployment: leave this UNSET. The root frontend's
# production build then calls same-origin `/api`, which Nginx reverse
# proxies to the Runtime (see deploy/linux/nginx-cheersai-vault.conf) —
# do not hard-code a server IP into the frontend build.
#
# Local development / cross-origin debugging only: set to an http://
# loopback address (127.0.0.1 / localhost / [::1]) — both frontends
# reject anything else at startup (src/lib/runtime/client.ts and
# apps/vault-pro-web/src/api/client.ts validateBaseUrl()).
# Optional. Default when unset in dev: "http://127.0.0.1:8787".
VITE_RUNTIME_API_URL=http://127.0.0.1:8787

# =============================================================
# Legacy .ppt conversion (LibreOffice) — read by the Runtime
# binary (apps/vault-runtime-api/src/legacy_powerpoint.rs).
# =============================================================

# Explicit path to a runnable `soffice` binary, for when LibreOffice is not
# installed in one of the standard locations the Runtime already searches
# (macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice,
# /opt/homebrew/bin/soffice, /usr/local/bin/soffice, then PATH). Set this
# explicitly in production rather than relying on the search order or any
# /tmp-based fallback — see docs/enterprise/DEPLOYMENT.md.
# Optional. No default; only needed if auto-discovery does not find your
# installation.
CHEERSAI_LIBREOFFICE_PATH=/path/to/soffice

# =============================================================
# FileBay browser upload (apps/vault-runtime-api/src/filebay.rs)
# — read directly by the Rust binary exactly once, at startup.
# =============================================================
#
# These four variables are the ONLY source of FileBay configuration for the
# browser adapter. The browser can never read, set, or override them — it
# only sees a safe status derived from whichever of the four states below
# applies, and can trigger three explicit, user-initiated actions (test
# connection, create the configured private repository, confirm an upload).
#
# - All four unset: FileBay status is "unconfigured"; the rest of the
#   Runtime starts and runs normally.
# - All four set and valid: status is "configured".
# - Only some are set, or the URL/owner/repo fail validation: status is
#   "invalid"; the rest of the Runtime still starts normally, but every
#   FileBay write action fails closed with a fixed safe error.
# - To change configuration, edit the process environment and restart the
#   Runtime — there is no live-reload and no admin API for this.
#
# Set all four together, or leave all four unset.

# FileBay/Gitea server origin. Must be a bare HTTPS root origin: scheme
# "https", a host, and no userinfo, query string, fragment, or non-root
# path (e.g. "https://filebay.example.com" — NOT
# "https://user:pass@filebay.example.com/sub/path?x=1"). Certificate
# verification is always on; there is no option anywhere to disable it.
VAULT_FILEBAY_URL=https://filebay.example.com

# FileBay/Gitea access token for the account the Runtime uploads as. Never
# logged, never returned to the browser (the status API only exposes a
# `has_token: boolean`), never written to the Runtime's SQLite database.
VAULT_FILEBAY_TOKEN=changeme

# FileBay/Gitea repository owner (user or organization). Restricted to the
# same identifier characters Gitea itself accepts; anything else makes the
# configuration "invalid" at startup.
VAULT_FILEBAY_OWNER=your-org

# FileBay/Gitea repository name the Runtime uploads masked Markdown into.
# If it does not already exist, the browser's "create repository" action
# creates it as **private** — the Runtime never creates a public repository
# on the browser's behalf.
VAULT_FILEBAY_REPO=vault-artifacts
